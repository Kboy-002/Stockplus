# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rvet

# Required — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Production: add your Vercel URL(s), comma-separated (no trailing slash). Localhost is always allowed.
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# Optional (default: 5000)
# PORT=5000
