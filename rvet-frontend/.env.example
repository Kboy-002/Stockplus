# Local: leave unset (dev server defaults to localhost:5000/api) or set explicitly:
# VITE_API_URL=http://localhost:5000/api

# Vercel (Production + Preview): required — must match your Render API, end with /api
# VITE_API_URL=https://your-service.onrender.com/api

# Set to "true" only for offline UI dev without a database
# VITE_USE_MOCK_DATA=false
